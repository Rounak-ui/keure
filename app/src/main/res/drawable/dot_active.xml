<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>

    <!-- Center -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>

    </item>

</layer-list>