<?xml version="1.0" encoding="utf-8"?>
<com.example.keure.GestureAwareKeyboardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#212121"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Translator bar: hidden until swipe down -->
    <LinearLayout
        android:id="@+id/translator_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/key_translate_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Close translator"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/translate_src"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/search_pill_bg"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="English"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/translate_swap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="⇄"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/translate_dst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/search_pill_bg"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="Hindi"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- spacer so the language chips stay centered -->
            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/translate_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/search_pill_bg"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:text="Type here to translate"
            android:textColor="#AAAAAA"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Suggestion / hint bar -->
    <LinearLayout
        android:id="@+id/suggestion_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/key_menu_grid"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_manage" />

        <TextView
            android:id="@+id/suggestion_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#555555" />

        <TextView
            android:id="@+id/suggestion_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#555555" />

        <TextView
            android:id="@+id/suggestion_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/key_mic"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice input"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_btn_speak_now" />

    </LinearLayout>

    <!-- Number row -->
    <LinearLayout
        android:id="@+id/number_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/key_1"
            style="@style/KeureKey"
            android:text="1" />

        <Button
            android:id="@+id/key_2"
            style="@style/KeureKey"
            android:text="2" />

        <Button
            android:id="@+id/key_3"
            style="@style/KeureKey"
            android:text="3" />

        <Button
            android:id="@+id/key_4"
            style="@style/KeureKey"
            android:text="4" />

        <Button
            android:id="@+id/key_5"
            style="@style/KeureKey"
            android:text="5" />

        <Button
            android:id="@+id/key_6"
            style="@style/KeureKey"
            android:text="6" />

        <Button
            android:id="@+id/key_7"
            style="@style/KeureKey"
            android:text="7" />

        <Button
            android:id="@+id/key_8"
            style="@style/KeureKey"
            android:text="8" />

        <Button
            android:id="@+id/key_9"
            style="@style/KeureKey"
            android:text="9" />

        <Button
            android:id="@+id/key_0"
            style="@style/KeureKey"
            android:text="0" />
    </LinearLayout>

    <!-- Letters container: wraps the 3 QWERTY rows, hidden when symbols layer is active -->
    <LinearLayout
        android:id="@+id/letters_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row: q w e r t y u i o p -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_q"
                style="@style/KeureKey"
                android:text="q"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_w"
                style="@style/KeureKey"
                android:text="w"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_e"
                style="@style/KeureKey"
                android:text="e"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_r"
                style="@style/KeureKey"
                android:text="r"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_t"
                style="@style/KeureKey"
                android:text="t"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_y"
                style="@style/KeureKey"
                android:text="y"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_u"
                style="@style/KeureKey"
                android:text="u"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_i"
                style="@style/KeureKey"
                android:text="i"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_o"
                style="@style/KeureKey"
                android:text="o"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_p"
                style="@style/KeureKey"
                android:text="p"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row: a s d f g h j k l -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_a"
                style="@style/KeureKey"
                android:text="a"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_s"
                style="@style/KeureKey"
                android:text="s"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_d"
                style="@style/KeureKey"
                android:text="d"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_f"
                style="@style/KeureKey"
                android:text="f"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_g"
                style="@style/KeureKey"
                android:text="g"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_h"
                style="@style/KeureKey"
                android:text="h"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_j"
                style="@style/KeureKey"
                android:text="j"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_k"
                style="@style/KeureKey"
                android:text="k"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_l"
                style="@style/KeureKey"
                android:text="l"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Row: shift z x c v b n m backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_shift"
                style="@style/KeureKeySpecial"
                android:layout_weight="1.5"
                android:text="⇧" />

            <Button
                android:id="@+id/key_z"
                style="@style/KeureKey"
                android:text="z"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_x"
                style="@style/KeureKey"
                android:text="x"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_c"
                style="@style/KeureKey"
                android:text="c"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_v"
                style="@style/KeureKey"
                android:text="v"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_b"
                style="@style/KeureKey"
                android:text="b"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_n"
                style="@style/KeureKey"
                android:text="n"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_m"
                style="@style/KeureKey"
                android:text="m"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_backspace"
                style="@style/KeureKeySpecial"
                android:layout_weight="1.5"
                android:text="⌫" />
        </LinearLayout>

    </LinearLayout>

    <!-- Symbols container: shown instead of letters when ?123 is active -->
    <LinearLayout
        android:id="@+id/symbols_container"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">
        <!-- Empty spacer row - keeps row height consistent with letters layer (3 rows) -->
        <!-- Row 0: α β γ θ λ σ ω ₹ € ¥ -->
        <LinearLayout
            android:id="@+id/symbols_spacer_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym_alpha"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="α" />

            <Button
                android:id="@+id/key_sym_beta"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="β" />

            <Button
                android:id="@+id/key_sym_gamma"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="γ" />

            <Button
                android:id="@+id/key_sym_theta"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="θ" />

            <Button
                android:id="@+id/key_sym_lambda"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="λ" />

            <Button
                android:id="@+id/key_sym_sigma"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="σ" />

            <Button
                android:id="@+id/key_sym_omega"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="ω" />

            <Button
                android:id="@+id/key_sym_rupee"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="₹" />

            <Button
                android:id="@+id/key_sym_brightness"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="⛭" />

            <Button
                android:id="@+id/key_sym_mute"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="˒﹚)" />
        </LinearLayout>
        <!-- Row 1: @ # $ _ & - + ( ) / -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym_at"
                style="@style/KeureKey"
                android:text="@" />

            <Button
                android:id="@+id/key_sym_hash"
                style="@style/KeureKey"
                android:text="#" />

            <Button
                android:id="@+id/key_sym_dollar"
                style="@style/KeureKey"
                android:text="$" />

            <Button
                android:id="@+id/key_sym_underscore"
                style="@style/KeureKey"
                android:text="_" />

            <Button
                android:id="@+id/key_sym_amp"
                style="@style/KeureKey"
                android:text="&amp;" />

            <Button
                android:id="@+id/key_sym_dash"
                style="@style/KeureKey"
                android:text="-" />

            <Button
                android:id="@+id/key_sym_plus"
                style="@style/KeureKey"
                android:text="+" />

            <Button
                android:id="@+id/key_sym_lparen"
                style="@style/KeureKey"
                android:text="(" />

            <Button
                android:id="@+id/key_sym_rparen"
                style="@style/KeureKey"
                android:text=")" />

            <Button
                android:id="@+id/key_sym_slash"
                style="@style/KeureKey"
                android:text="/" />
        </LinearLayout>

        <!-- Row 2: =\< * " ' : ; ! ? backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym_page2"
                style="@style/KeureKeySpecial"
                android:text="=\&lt;"
                android:textSize="14sp" />

            <Button
                android:id="@+id/key_sym_star"
                style="@style/KeureKey"
                android:text="*" />

            <Button
                android:id="@+id/key_sym_quote"
                style="@style/KeureKey"
                android:text="&quot;" />

            <Button
                android:id="@+id/key_sym_apos"
                style="@style/KeureKey"
                android:text="'" />

            <Button
                android:id="@+id/key_sym_colon"
                style="@style/KeureKey"
                android:text=":" />

            <Button
                android:id="@+id/key_sym_semicolon"
                style="@style/KeureKey"
                android:text=";" />

            <Button
                android:id="@+id/key_sym_exclaim"
                style="@style/KeureKey"
                android:text="!" />

            <Button
                android:id="@+id/key_sym_question"
                style="@style/KeureKey"
                android:text="?" />

            <Button
                android:id="@+id/key_sym_backspace"
                style="@style/KeureKeySpecial"
                android:layout_weight="1.5"
                android:text="⌫" />
        </LinearLayout>

    </LinearLayout>

    <!-- Symbols page 2: math/currency/misc symbols -->
    <LinearLayout
        android:id="@+id/symbols_page2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: ~ ` | . √ π ÷ × § △ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym2_tilde"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="~" />

            <Button
                android:id="@+id/key_sym2_backtick"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="`" />

            <Button
                android:id="@+id/key_sym2_pipe"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="|" />

            <Button
                android:id="@+id/key_sym2_dot"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="•" />

            <Button
                android:id="@+id/key_sym2_sqrt"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="√" />

            <Button
                android:id="@+id/key_sym2_pi"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="π" />

            <Button
                android:id="@+id/key_sym2_divide"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="÷" />

            <Button
                android:id="@+id/key_sym2_multiply"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="×" />

            <Button
                android:id="@+id/key_sym2_section"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="§" />

            <Button
                android:id="@+id/key_sym2_triangle"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="△" />
        </LinearLayout>

        <!-- Row 2: £ ¢ € ¥ ^ ° = { } \ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym2_pound"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="£" />

            <Button
                android:id="@+id/key_sym2_cent"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="¢" />

            <Button
                android:id="@+id/key_sym2_euro"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="€" />

            <Button
                android:id="@+id/key_sym2_yen"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="¥" />

            <Button
                android:id="@+id/key_sym2_caret"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="^" />

            <Button
                android:id="@+id/key_sym2_degree"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="°" />

            <Button
                android:id="@+id/key_sym2_equals"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="=" />

            <Button
                android:id="@+id/key_sym2_lbrace"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="{" />

            <Button
                android:id="@+id/key_sym2_rbrace"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="}" />

            <Button
                android:id="@+id/key_sym2_backslash"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="\\" />
        </LinearLayout>

        <!-- Row 3: ?123 % © ® ™ ✓ [ ] backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_sym2_toPage1"
                style="@style/KeureKeySpecial"
                android:layout_height="match_parent"
                android:text="123"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/key_sym2_percent"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="%" />

            <Button
                android:id="@+id/key_sym2_copyright"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="©" />

            <Button
                android:id="@+id/key_sym2_registered"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="®" />

            <Button
                android:id="@+id/key_sym2_tm"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="™" />

            <Button
                android:id="@+id/key_sym2_check"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="✓" />

            <Button
                android:id="@+id/key_sym2_lbracket"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="[" />

            <Button
                android:id="@+id/key_sym2_rbracket"
                style="@style/KeureKey"
                android:layout_height="match_parent"
                android:text="]" />

            <Button
                android:id="@+id/key_sym2_backspace"
                style="@style/KeureKeySpecial"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:text="⌫" />
        </LinearLayout>

    </LinearLayout>

    <!-- Emoji/GIF/Sticker panel: shown on up-swipe or tapping the emoji key -->

    <LinearLayout
        android:id="@+id/emoji_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header: back arrow + small search-style bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/key_emoji_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/arrow_back" />

            <LinearLayout
                android:id="@+id/search_pill"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/search_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Search"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#888888" />

                <TextView
                    android:id="@+id/emoji_page_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Search"
                    android:textColor="#888888"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Recent searches card (search mode only) -->
        <LinearLayout
            android:id="@+id/search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/search_pill_bg"
            android:orientation="vertical"
            android:visibility="gone" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/emoji_pager"
            android:layout_width="match_parent"
            android:layout_height="260dp" />

        <!-- Emoji panel's own bottom row: ABC + dots + backspace -->
        <LinearLayout
            android:id="@+id/emoji_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/key_emoji_back"
                style="@style/KeureKeySpecial"
                android:layout_width="10dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="ABC"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/pageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/dot_active" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/dot_inactive" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/dot_inactive" />

            </LinearLayout>

            <Button
                android:id="@+id/key_emoji_backspace"
                style="@style/KeureKeySpecial"
                android:layout_width="10dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="⌫"
                android:textAllCaps="false"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom row: ?123, comma, emoji, space, period, enter -->
    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_symbols"
            style="@style/KeureKeySpecial"
            android:layout_weight="1.3"
            android:singleLine="true"
            android:text="123"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/key_comma"
            style="@style/KeureKey"
            android:layout_weight="0.8"
            android:text="," />

        <ImageButton
            android:id="@+id/key_emoji"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg_special"
            android:contentDescription="Emoji"
            android:scaleType="centerInside"
            android:src="@drawable/emoji" />

        <Button
            android:id="@+id/key_space"
            style="@style/KeureKey"
            android:layout_weight="3.5"
            android:text="" />

        <Button
            android:id="@+id/key_period"
            style="@style/KeureKey"
            android:layout_weight="0.8"
            android:text="." />

        <ImageButton
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:layout_weight="1.3"
            android:background="@drawable/enter_bg"
            android:contentDescription="Enter"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/keyboard_return" />

    </LinearLayout>

</com.example.keure.GestureAwareKeyboardLayout>